# =============================================================================
# 42 PROJECTS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and uncomment the configuration you need
# For development: Uncomment the "DEVELOPMENT" sections
# For production: Uncomment the "PRODUCTION" sections
# =============================================================================

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
SECRET_KEY=f99a522c1ecb1996a2b6ac30a44423a3aa2bafece1dc3fab6bcb

# DEVELOPMENT
DEBUG=True
DJANGO_ENV=development

# PRODUCTION
# DEBUG=False
# DJANGO_ENV=production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_NAME=projects42_db
DB_USER=projects42_user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# 42 API OAuth Credentials
# -----------------------------------------------------------------------------
# Get these from: https://profile.intra.42.fr/oauth/applications
API_42_UID=your_uid_here
API_42_SECRET=your_secret_here

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# IMPORTANT: Make sure your 42 OAuth application has the correct redirect URI:
# - Development: http://localhost/api/auth/callback/
# - Production: https://42projects.cc/api/auth/callback/
#
# NOTE: Don't add ports! Nginx runs on port 80 and handles all routing.

# DEVELOPMENT - Local development (nginx on port 80)
APP_DOMAIN=localhost,127.0.0.1
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost

# PRODUCTION - Deployed with domain and HTTPS
# APP_DOMAIN=42projects.cc,.42projects.cc,www.42projects.cc,nginx
# FRONTEND_URL=https://42projects.cc
# BACKEND_URL=https://42projects.cc

# -----------------------------------------------------------------------------
# Superuser Configuration (Optional - for automatic creation on first run)
# -----------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@42projects.local
DJANGO_SUPERUSER_PASSWORD=admin123
